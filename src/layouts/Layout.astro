---
import PaperBackground from '../components/PaperBackground.vue';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Baneronetwo — Developer & Creator",
  description = "Frontend & Backend Developer з України. Створення цифрових продуктів, локалізація та підтримка інтернет-спільнот.",
} = Astro.props;
---

<!doctype html>
<html lang="uk" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=cat" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- ТАКОЖ МОЖЕТЕ ЙОПТА БРАТИ САЙТ ЯК ПРИКЛАД....АЛЕ СУЧКИ НЕ ЧИПАЙ КОМЕНТИ, БО НІХУЯ НЕ ЗРОЗУМІЮ-->
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts: Plus Jakarta Sans (Modern Geometric Display), Inter, and JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Theme inline script to prevent flash of light/dark mode -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        const userPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && userPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body
    class="min-h-screen bg-[#f8f9fa] dark:bg-[#0a0c10] text-slate-900 dark:text-slate-100 font-sans antialiased selection:bg-blue-500/20 selection:text-blue-600 dark:selection:text-blue-300 transition-colors duration-300 relative overflow-x-clip"
  >
    <!-- Lightweight Technical Paper Grid Background -->
    <PaperBackground client:only="vue" />

    <slot />
  </body>
</html>

<style is:global>
  ::selection {
    background-color: rgba(37, 99, 235, 0.2);
    color: inherit;
  }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    letter-spacing: -0.015em;
  }

  /* Minimalist Technical Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(161, 161, 170, 0.3);
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(161, 161, 170, 0.55);
  }

  /* -------------------------------------------------------------
     UKRAINIAN FLAG THEME OVERTAKE (TRIGGERED ON 'RU' LOCALE)
     "якщо на РУ увімкнулось - то усюди кнопки, фон змінився на прапора україни !"
     ------------------------------------------------------------- */
  html[data-patriotic="ua"] ::selection {
    background-color: #ffd700 !important;
    color: #0057b7 !important;
  }

  /* All Primary, Secondary & CTA Buttons turn into Ukrainian Flag paper style (Cubic) */
  html[data-patriotic="ua"] .apple-btn-primary,
  html[data-patriotic="ua"] .apple-btn-secondary,
  html[data-patriotic="ua"] .paper-btn-primary,
  html[data-patriotic="ua"] .paper-btn-secondary,
  html[data-patriotic="ua"] a.apple-btn-primary,
  html[data-patriotic="ua"] a.apple-btn-secondary,
  html[data-patriotic="ua"] button.apple-btn-primary,
  html[data-patriotic="ua"] button.apple-btn-secondary,
  html[data-patriotic="ua"] .apple-card button:not([aria-label="Change language"]):not([title="Stop Anthem"]):not([title="Змінити тему"]),
  html[data-patriotic="ua"] .paper-card button:not([aria-label="Change language"]):not([title="Stop Anthem"]):not([title="Змінити тему"]),
  html[data-patriotic="ua"] .apple-card a[target="_blank"],
  html[data-patriotic="ua"] .paper-card a[target="_blank"] {
    position: relative;
    border-radius: 0 !important;
    background: linear-gradient(180deg, #0057b7 0%, #0057b7 50%, #ffd700 50%, #ffd700 100%) !important;
    color: #ffffff !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85);
    border: 2px solid rgba(255, 215, 0, 0.9) !important;
    box-shadow: 3px 3px 0px rgba(0, 87, 183, 0.5) !important;
    transition: all 0.15s ease !important;
  }

  html[data-patriotic="ua"] .apple-btn-primary:hover,
  html[data-patriotic="ua"] .apple-btn-secondary:hover,
  html[data-patriotic="ua"] .paper-btn-primary:hover,
  html[data-patriotic="ua"] .paper-btn-secondary:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px rgba(0, 87, 183, 0.7) !important;
  }

  /* All Status Pills & Badges become Ukrainian Gold & Azure (Cubic) */
  html[data-patriotic="ua"] .apple-pill,
  html[data-patriotic="ua"] .paper-pill {
    border-radius: 0 !important;
    background: linear-gradient(180deg, rgba(0, 87, 183, 0.2) 0%, rgba(0, 87, 183, 0.2) 50%, rgba(255, 215, 0, 0.2) 50%, rgba(255, 215, 0, 0.2) 100%) !important;
    border-color: rgba(0, 87, 183, 0.6) !important;
    color: #0057b7 !important;
    font-weight: 700;
  }

  /* Navbar active tab button turns into Ukrainian Flag pill */
  html[data-patriotic="ua"] nav[role="tablist"] button[aria-selected="true"] {
    background: linear-gradient(180deg, #0057b7 0%, #0057b7 50%, #ffd700 50%, #ffd700 100%) !important;
    color: #ffffff !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(255, 215, 0, 0.8) !important;
  }

  /* Cards get subtle Ukrainian paper accent border */
  html[data-patriotic="ua"] .apple-card,
  html[data-patriotic="ua"] .paper-card {
    border-color: rgba(0, 87, 183, 0.25) !important;
  }
</style>
